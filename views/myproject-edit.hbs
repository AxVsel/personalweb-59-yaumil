<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Project Add</title>
  <link rel="stylesheet" href="/assets/css/myproject.css" />
</head>

<body>
  {{#> layout title="MyProject" user=user}}

  <main>
    <form action="/myproject-update/{{data.id}}" enctype="multipart/form-data" method="post" id="contactForm" class="contact-form">
      <h1>ADD MY PROJECT</h1>
      <div class="form-field">
        <input type="hidden" name="id" value="{{data.id}}" />
        <label for="projectname">Project Name</label>
        <input id="projectname" name="projectname" value="{{data.projectname}}" class="form-input" type="text"
          placeholder="Project Name" required />
      </div>

      <div class="date-column">
        <div class="form-field-date1">
          <label for="startdate">Start Date</label>
          <input id="startdate" name="startdate" value="{{data.startdate}}" class="form-input-date" type="date"
            required />
        </div>

        <div class="form-field-date2">
          <label for="enddate">End Date</label>
          <input id="enddate" name="enddate" value="{{data.enddate}}" class="form-input-date" type="date" required />
        </div>
      </div>

      <div class="form-field">
        <label class="message-contact" for="description">Description</label>
        <textarea id="description" name="description" class="form-input" rows="6"
          required>{{data.description}}</textarea>
      </div>

      <div class="form-checkbox">
        <label for="technologies">Technologies</label>
        <div class="form-field-checkbox1">
          <input type="checkbox" id="technologiesA" name="technologiesA"
            value="http://localhost:2002/assets/img/node.png" {{#if data.technologiesA }}checked{{/if}}
            class="form-input-checkbox" />
          <span class="checkboxlabel">Node JS</span>
          <input type="checkbox" id="technologiesB" name="technologiesB"
            value="http://localhost:2002/assets/img/react.png" {{#if data.technologiesB }}checked{{/if}}
            class="form-input-checkbox" />
          <span class="checkboxlabel">React JS</span>
        </div>
        <div class="form-field-checkbox2">
          <input type="checkbox" id="technologiesC" name="technologiesC"
            value="http://localhost:2002/assets/img/next.png" {{#if data.technologiesC }}checked{{/if}}
            class="form-input-checkbox" />
          <span class="checkboxlabel">Next JS</span>
          <input type="checkbox" id="technologiesD" name="technologiesD"
            value="http://localhost:2002/assets/img/typescript.png" {{#if data.technologiesD }}checked{{/if}}
            class="form-input-checkbox" />
          <span class="checkboxlabel">Typescript</span>
        </div>
      </div>

      <div class="form-field">
        <label for="input-blog-image" class="form-label">Upload Image</label>
        <input id="image" name="image" class="form-input" type="file" placeholder="title" />
      </div>

      <div class="btn-right">
        <button type="submit" class="form-submit-button">Edit</button>
      </div>
    </form>
  </main>

  <!-- Include SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Load external JavaScript -->
  <script src="/assets/js/test.js"></script>
  {{/layout}}
</body>

</html>